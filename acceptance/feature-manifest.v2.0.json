        {
          "featureId": "runtime.inventory",
          "userVisibleName": "运行时分组与管理边界",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-runtimes", "selectors": ["#runtime-list", "#runtime-discovery-groups", "#managed-jdks", "#runtime-migration-result"] },
          "backendCommands": ["discover_runtimes", "install_jdk", "install_node", "install_python", "install_go", "install_maven", "install_gradle", "switch_runtime", "uninstall_runtime", "list_runtime_switch_backups"],
          "riskLevel": "high",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "managedExternalBoundary", "installDoesNotAutoSwitch", "resultPanelVisible"]
        },
        {
          "featureId": "runtime.verification",
          "userVisibleName": "运行时强验证与报告",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-runtimes", "selectors": ["#inspect-runtime-strong", "#runtime-strong-result", "#export-runtime-report-markdown"] },
          "backendCommands": ["inspect_runtime_strong_verification", "export_runtime_verification_report"],
          "riskLevel": "readOnly",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "boundedProbe"]
        },
        {
          "featureId": "runtime.platformProviders",
          "userVisibleName": "Go、Rust 与 .NET Provider 状态和持久结果",
          "status": "implemented",
          "priority": "P1",
          "frontendEntry": { "viewId": "view-platforms", "selectors": ["#managed-gos", "#rust-platform", "#rust-provider-controls", "#rust-toolchain-channel", "#rust-install-toolchain", "#rust-uninstall-toolchain", "#dotnet-platform", "#platform-operation-result"] },
          "backendCommands": ["inspect_platform_toolchains", "run_platform_action"],
          "riskLevel": "high",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "providerBoundary", "rustupManagedOnly", "installDoesNotSetDefault"]
        }
      ]
    },
    {
      "pageId": "environment",
      "displayName": "环境",
      "features": [
        {
          "featureId": "environment.reliability",
          "userVisibleName": "JAVA_HOME、PATH 与 Python 可靠性",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-environment", "selectors": ["#env-reliability-result", "#env-repair-plan-result"] },
          "backendCommands": ["inspect_env_reliability", "create_env_repair_plan", "apply_env_repair_plan"],
          "riskLevel": "high",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "backendBoundPlan"]
        }
      ]
    },
    {
      "pageId": "project",
      "displayName": "项目",
      "features": [
        {
          "featureId": "project.analysis",
          "userVisibleName": "项目分析、配置预览与验证",
          "status": "implemented",
          "priority": "P1",
          "frontendEntry": { "viewId": "view-project", "selectors": ["#project-path", "#check-project", "#project-config-preview", "#project-output"] },
          "backendCommands": ["analyze_project", "preview_project_configuration", "inspect_project_port_configs", "inspect_idea_project", "verify_java_consumer_environment"],
          "riskLevel": "readOnly",
          "requiresTauri": true,
          "requiresWindows": false,
          "safeSmokeMode": "manual",
          "manualOnlyReason": "需要用户明确选择测试项目目录。",
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "directoryPickerVisible"]
        }
      ]
    },
    {
      "pageId": "maintenance",
      "displayName": "空间分析",
