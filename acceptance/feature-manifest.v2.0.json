          "priority": "P0",
          "frontendEntry": { "viewId": "view-toolbox", "selectors": ["#file-association-manager"] },
          "backendCommands": ["scan_file_associations", "search_file_association_app", "create_file_association_plan", "apply_file_association_plan", "rollback_file_association_backup"],
