          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "static",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "directoryPickerVisible"]
        },
        {
          "featureId": "cleanup.archive",
          "userVisibleName": "桌面、下载与通用归档",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-maintenance", "selectors": ["#preview-desktop-archive", "#preview-downloads-archive", "#move-plan-result", "#rollback-records"] },
          "backendCommands": ["create_move_plan", "execute_move_plan", "rollback_move"],
          "riskLevel": "high",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "manual",
          "manualOnlyReason": "自动验收不得移动真实用户文件。",
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "backendBoundPlan", "rollbackVisible"]
        }
      ]
