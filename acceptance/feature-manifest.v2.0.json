{
  "$schema": "./acceptance-schema.json",
  "schemaVersion": 1,
  "productVersion": "2.0.0-development",
  "pages": [
    {
      "pageId": "overview",
      "displayName": "总览",
      "features": [
        {
          "featureId": "overview.snapshot",
          "userVisibleName": "系统与配置快照",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-overview", "selectors": ["#snapshot-list", "#metric-root", "#effective-runtime-list"] },
          "backendCommands": ["app_snapshot", "load_config", "env_snapshot"],
          "riskLevel": "readOnly",
          "requiresTauri": true,
          "requiresWindows": false,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible"]
        }
      ]
    },
    {
      "pageId": "doctor",
      "displayName": "环境医生",
      "features": [
        {
          "featureId": "doctor.diagnose",
          "userVisibleName": "一键诊断与持久结果",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-doctor", "selectors": ["#run-doctor", "#doctor-score", "#doctor-checks"] },
          "backendCommands": ["run_doctor"],
          "riskLevel": "readOnly",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "noToastOnly"]
        }
      ]
    },
    {
      "pageId": "ports",
      "displayName": "端口",
      "features": [
        {
          "featureId": "ports.scan",
          "userVisibleName": "端口扫描、分类与原因",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-ports", "selectors": ["#scan-ports", "#ports-body", "#port-operation-result"] },
          "backendCommands": ["scan_ports", "port_history", "export_port_report"],
          "riskLevel": "readOnly",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "readOnly",
          "manualOnlyReason": null,
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "resultPanelVisible", "rowReasonVisible"]
        },
        {
          "featureId": "ports.release",
          "userVisibleName": "低风险端口一键释放",
          "status": "implemented",
          "priority": "P0",
          "frontendEntry": { "viewId": "view-ports", "selectors": ["#port-detail"] },
          "backendCommands": ["release_user_port"],
          "riskLevel": "high",
          "requiresTauri": true,
          "requiresWindows": true,
          "safeSmokeMode": "manual",
          "manualOnlyReason": "验收不得结束真实用户进程；自动测试只验证保护规则。",
          "acceptanceChecks": ["frontendEntryVisible", "backendCommandRegistered", "protectedProcessGuard", "durableResult"]
        }
      ]
    },
    {
      "pageId": "runtimes",
      "displayName": "版本管理",
